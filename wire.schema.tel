tel 1.0 specification.tel/tels:1.0.0
name wire

# The Fury protocol (fury.md §8): what one instance of Fury says to another. Every message is
# one case of a single coproduct, `Wire`, and is sent as a BinTEL document under this schema.
# Neither end assumes what the other can read: each begins a connection by sending its
# acceptance (BinTEL §8.4) of this schema, and writes each message to the acceptance it was
# sent.
#
# This file is the schema as `fury.Wire` derives it from its Scala types, written out; the two
# are checked to have the same signature, so a change to either must be made to both. An
# instant is the milliseconds since the Unix epoch, as a whole number; an id is a UUID in its
# hyphenated form; a hostname is a DNS name.

# Asks the other end to answer. `note` is shown in its log.
record Ping
  field id String
  field sent String
  field note String

# Answers the ping of the same `id`, saying when it arrived and who answers.
record Pong
  field id String
  field received String
  field hostname String

# Sent by each end of a lasting connection once a second. An end which hears none for three
# seconds takes the connection for lost.
record Beat
  field sent String

select Wire
  variant ping Ping
  variant pong Pong
  variant beat Beat

document
  select Wire
